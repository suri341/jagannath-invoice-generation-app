# Database
# Local development (host machine / docker-postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_db
# Kubernetes StatefulSet / same namespace service:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/invoice_db
# If the DB is in a different namespace, use:
# DATABASE_URL=postgresql://postgres:postgres@postgres.<namespace>.svc.cluster.local:5432/invoice_db

# Security
SECRET_KEY=your-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
DEBUG=True
APP_NAME=Jagannath Enterprises Invoice System
